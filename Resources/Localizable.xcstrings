          }
        }
      }
    },
    "当前由 %@控制。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Currently held by %@."
          }
        }
      }
    },
    "当前电量 %lld%%，低于低电量阈值，请先充电。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Battery is at %lld%%, below the low-battery threshold. Charge first."
          }
        }
      }
    },
    "忽略": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
